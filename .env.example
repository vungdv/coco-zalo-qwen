# Copy to .env and fill in. Never commit .env.

# Required: the Supabase orders API (bep-phuong-bac-supabase). The key is never logged.
SUPABASE_URL=
SUPABASE_API_KEY=

# Zalo
ZALO_CHAT=                     # title of the group chat to open; empty = the chat already open (must be a group)
BACKFILL_DAYS=3
POLL_INTERVAL_SECONDS=2

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=20

# Pipeline
RETRY_MAX_BACKOFF_SECONDS=60
MAX_ATTEMPTS=5
MAX_DAYS_AHEAD=31
INCLUDE_OWN_MESSAGES=false
AUDIT_DB_PATH=./data/audit.db

# Chef voice commands (spec v3). Off until the Voice Command API is deployed.
VOICE_COMMANDS=0
# VOICE_POLL_SECONDS=2
# VOICE_LLM_TIMEOUT_SECONDS=15
# VOICE_OLLAMA_MODEL=        # default: OLLAMA_MODEL

# Logging
LOG_LEVEL=INFO

# Browser and Reader internals (rarely changed)
# SELECTORS_PATH=           # default: the selectors.json shipped with the package
# ZALO_URL=https://chat.zalo.me
# PW_SESSION=zalo
# PW_PROFILE_DIR=./data/browser-profile
# STATE_DB_PATH=./data/acked.db
# BROWSER_MAX_RESTARTS=3
# BACKFILL_MAX_STEPS=500
# BACKFILL_SETTLE_SECONDS=0.6
# PUBLISH_TIMEOUT_SECONDS=30
